# The crawler. A separate program with its own image, its own database and its
# own lifecycle — event-scout asks it for events over HTTP and is otherwise
# unaware of it, so this can be restarted, rebuilt or switched off on its own.
#
# Node 24 for `node:sqlite`. No runtime dependencies at all: the frontier is
# SQLite, the server is node:http, and a crawler is the last thing that should
# be dragging half of npm onto a machine.
FROM docker.io/library/node:24-slim AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY server/package.json server/package.json
COPY web/package.json web/package.json
COPY crawler/package.json crawler/package.json
RUN npm ci

COPY crawler crawler
COPY tsconfig*.json ./
RUN npm run build --workspace crawler


FROM docker.io/library/node:24-slim
ENV NODE_ENV=production
WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/crawler/dist ./crawler/dist
COPY --from=build /app/crawler/package.json ./crawler/package.json

# The frontier and the finds. Worth a volume so a restart does not throw away
# what the crawl has learned, but nothing in here is precious: delete it and it
# rebuilds from the seeds.
RUN mkdir -p /app/data && chown -R node:node /app/data
VOLUME /app/data
ENV CRAWLER_DATA=/app/data

USER node
EXPOSE 3002
ENV CRAWLER_PORT=3002

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "crawler/dist/index.js"]
