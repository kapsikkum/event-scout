# A full Chromium running in the new headless mode, rather than the
# `chromedp/headless-shell` image the obvious way would use.
#
# headless-shell is Chromium with the browser parts compiled out, and it shows:
# no window.chrome, an empty plugin list, a different feature set. Those are
# exactly the properties a bot check reads, and no amount of patching in the
# page makes a shell look like a browser as convincingly as a browser does.
# `--headless=new` runs the real binary with no screen attached, which is a far
# smaller lie to have to tell.
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      chromium \
      ca-certificates \
      # Without real fonts every page renders in fallback boxes, which both
      # breaks text extraction and stands out to anything measuring glyphs.
      fonts-liberation \
      fonts-noto-core \
      fonts-noto-color-emoji \
      dumb-init \
      # Relays the published port to the loopback one Chromium insists on
      # binding; see docker/chromium-entrypoint.sh.
      socat \
 && rm -rf /var/lib/apt/lists/*

# Copied while still root, and made executable here rather than relying on the
# mode it had in the build context — a checkout on Windows has no execute bit
# to preserve.
COPY docker/chromium-entrypoint.sh /usr/local/bin/chromium-entrypoint
RUN chmod +x /usr/local/bin/chromium-entrypoint

# Chromium's own sandbox needs privileges this container does not have, so it
# is switched off — but the process should still not be root.
RUN useradd --create-home --shell /usr/sbin/nologin browser \
 && mkdir -p /profile && chown browser:browser /profile
USER browser

EXPOSE 9222
VOLUME /profile

# The user agent is deliberately NOT set here. It is applied per page over the
# protocol, in server/src/useragent.ts, so there is one place to change it —
# a copy in this file would drift out of step with that one and produce a
# browser whose headers and client hints disagree, which is worse than either.
#
# The switches that must be set before the browser starts live in
# docker/chromium-entrypoint.sh; everything applied per page is in
# server/src/density/stealth.ts.
ENTRYPOINT ["dumb-init", "--", "/usr/local/bin/chromium-entrypoint"]
